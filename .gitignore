# Node.js dependencies and package-manager caches
node_modules/
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode, caches, test output, and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
venv/
env/

# Build and temporary files
build/
dist/
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp
*.bak
*~
*.log

# Local environment files
.env
.env.*
!.env.example

# Microsoft Office lock files
~$*.xlsx
~$*.xlsm
~$*.pptx
~$*.pptm

# Generated skill output directories
generated/
.generated/
output/
outputs/
artifacts/
extracted-images/
extracted_images/
inspection-images/
inspection_images/

# JSON inspection output produced by the Excel and PowerPoint analyzers
inspection.json
inspection-*.json
inspection_*.json
*.inspection.json
output.json
output-*.json
output_*.json

# Generated PDF and image files
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.svg
*.emf
*.wmf

# Intentionally versioned skill resources and test fixtures
!**/assets/**/*
!**/examples/**/*
!**/fixtures/**/*
!**/testdata/**/*

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
